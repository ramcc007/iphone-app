{
  "name": "numfall-site",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:site": "node tools/site/build.js",
    "build:admin": "node tools/site/build-admin.mjs",
    "build": "npm run typecheck && npm test && npm run build:site && npm run build:admin"
  },
  "dependencies": {
    "@vercel/functions": "^2.2.0",
    "@vercel/og": "^0.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}