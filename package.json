{
  "name": "numfall-site",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:site": "node tools/site/build.js",
    "build:admin": "node tools/site/build-admin.mjs",
    "build": "npm run typecheck && npm run lint && npm test && npm run build:site && npm run build:admin",
    "lint": "eslint --no-error-on-unmatched-pattern api writer admin tests"
  },
  "dependencies": {
    "@google-analytics/data": "^7.3.0",
    "@vercel/functions": "^2.2.0",
    "@vercel/og": "^0.8.5",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tiptap/core": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/node": "^22.10.0",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1"
  }
}
